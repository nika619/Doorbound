{
  "name": "doorbound",
  "version": "1.0.0",
  "description": "Doorbound: a live departure board for the household morning, as an Alexa+ add-on. Self-hosted MCP server (spec 2025-11-25 and 2026-07-28, Streamable HTTP) with an MCP App board.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nika619/Doorbound.git"
  },
  "homepage": "https://github.com/nika619/Doorbound#readme",
  "bugs": "https://github.com/nika619/Doorbound/issues",
  "keywords": ["alexa", "mcp", "model-context-protocol", "mcp-apps", "streamable-http", "household", "probability", "departure-board"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node dist/server.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "pilot": "tsx scripts/pilot.ts",
    "conformance": "node scripts/conformance.mjs",
    "screens": "node scripts/screens.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && tsx --env-file=demo.env src/server/main.ts",
    "video": "node scripts/record-demo.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lenis": "^1.3.27",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
