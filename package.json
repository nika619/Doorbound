{
  "name": "departures",
  "version": "1.0.0",
  "description": "Departures: a live departure board for the household morning, as an Alexa+ add-on. Self-hosted MCP server (spec 2025-11-25 and 2026-07-28, Streamable HTTP) with an MCP App board.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && tsx src/server/main.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && tsx --env-file=demo.env src/server/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
